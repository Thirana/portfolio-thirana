# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent session guides
AGENTS.md

# impeccable skill working files
.impeccable/

# local planning notes
docs/professional-grade-vercel-roadmap.md

# impeccable design skill (installed locally per machine, not part of the site)
.claude/skills/impeccable/
.claude/agents/impeccable-*.md
.github/skills/impeccable/
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json

# excalidraw diagram skill (its own git clone, installed locally)
.claude/skills/excalidraw-diagram-skill/

# excalidraw diagram previews (the sources are committed; the site uses the exported SVGs in public/diagrams)
content/**/diagrams/**/*.png
content/site-diagrams/*.png
